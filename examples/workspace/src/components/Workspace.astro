---
import Layout from '../layouts/Layout.astro';
import { ClientRouter } from 'astro:transitions';
const base = import.meta.env.BASE_URL;
const { alternate = false } = Astro.props;
---
<Layout title="Interactive workspace">
  <ClientRouter />
  <h1>{alternate ? 'Alternate workspace' : 'Interactive workspace'}</h1>
  <p><a href={`${base}${alternate ? 'workspace/' : 'workspace/alternate/'}`}>{alternate ? 'Main workspace' : 'Alternate workspace'}</a></p>
  <p>Compare two independent workspaces. Each shares state between HTML controls, a Solid table and a streaming summary.</p>
  <noscript><p role="status">The workspace requires JavaScript. <a href={`${base}guide/`}>Read the static guide</a>.</p></noscript>
  <button id="remount" type="button">Remount workspaces</button>
  <div class="workspaces">
    {['first', 'second'].map(name => <section data-workspace={name} data-service={`${base}api/`}>
      <h2>{name === 'first' ? 'First workspace' : 'Second workspace'}</h2>
      <div data-hypermedia>
        <label>Selection<select data-bind="selected"><option value="alpha">Alpha</option><option value="beta">Beta</option></select></label>
        <button type="button" data-on:click="$selected = 'beta'">Select beta</button>
        <button type="button" data-on:click="$clicks = $clicks + 1">Count click</button>
        <p>Selected: <strong data-selected data-text="$selected">alpha</strong> · Clicks: <span data-clicks data-text="$clicks">0</span></p>
        <p>Summary: <span data-summary data-text="$summary">Preparing…</span></p>
        <div id={`fragment-${name}`}><label>Fragment note<input id={`note-${name}`} data-bind="note" value="" /></label><p data-fragment-message>Waiting for server fragment</p></div>
      </div>
      <div data-solid id={`solid-${name}`}><p>Loading interactive controls…</p></div>
    </section>)}
  </div>
</Layout>
<script>
  import * as initial from '../../.client/workspace.js';
  let active = initial;
  const start = () => { void active.initialize(); };
  const stop = () => active.dispose();
  start();
  document.addEventListener('astro:page-load', start);
  document.addEventListener('astro:before-swap', stop);
  if (import.meta.hot) {
    import.meta.hot.accept('../../.client/workspace.js', next => {
      if (!next) return;
      stop(); active = next; start();
    });
    import.meta.hot.dispose(() => {
      stop();
      document.removeEventListener('astro:page-load', start);
      document.removeEventListener('astro:before-swap', stop);
    });
  }
</script>
