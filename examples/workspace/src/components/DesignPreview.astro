---
import Layout from '../layouts/Layout.astro';
import tokens from '@astrok/theme/tokens.json';
import darkLogo from '@astrok/theme/logos/astrok-mark-dark.svg?url';
import inkLogo from '@astrok/theme/logos/astrok-mark-ink.svg?url';
import whiteLogo from '@astrok/theme/logos/astrok-mark-white.svg?url';
import appIcon from '@astrok/theme/logos/astrok-app-icon.svg?url';
const { theme = 'dark' } = Astro.props as { theme?: 'dark' | 'light' };
const base = import.meta.env.BASE_URL;
const colors = tokens.color.tokens.filter(token => !token.value[theme].startsWith('{'));
---
<Layout title="Design system" theme={theme}>
  <div class="intro">
    <p class="eyebrow">Design system · version 1</p>
    <h1>astrok, sous tension.</h1>
    <p class="lede">One signature color. Clear type. Pages that come alive when you need them.</p>
    <nav aria-label="Design themes" class="theme-links">
      <a href={`${base}design-system/`} aria-current={theme === 'dark' ? 'page' : undefined}>Dark preview</a>
      <a href={`${base}design-system/light/`} aria-current={theme === 'light' ? 'page' : undefined}>Light preview</a>
    </nav>
  </div>

  <section aria-labelledby="cover-title">
    <h2 id="cover-title">The signature</h2>
    <figure class="design-cover" aria-label="astrok cover with four oblique cuts through a voltage-colored slab">
      <svg viewBox="0 0 960 288" preserveAspectRatio="xMaxYMid slice" aria-hidden="true">
        <rect fill="var(--ink)" x="520" y="128" width="96" height="136" rx="20" />
        <rect fill="var(--voltage)" x="640" y="-24" width="200" height="264" rx="20" />
        <g fill="var(--ground)">
          <polygon points="680,240 690,240 736.5,-24 726.5,-24" />
          <polygon points="712,240 722,240 768.5,-24 758.5,-24" />
          <polygon points="744,240 754,240 800.5,-24 790.5,-24" />
          <polygon points="776,240 786,240 832.5,-24 822.5,-24" />
        </g>
        <rect fill="var(--ink-muted)" x="864" y="168" width="120" height="96" rx="20" />
      </svg>
      <figcaption><strong>astrok</strong><span>Astro, Starlight et SolidJS, sous tension.</span></figcaption>
    </figure>
    <p class="muted">The supplied 960 × 288 cover is adapted here to fit small screens. Text and tokens stay live.</p>
  </section>

  <section aria-labelledby="type-title">
    <h2 id="type-title">Type, with purpose</h2>
    <div class="specimen-grid">
      <div class="specimen"><p class="eyebrow">Sora · 600</p><h3>Branche un signal,<br/>la page réagit.</h3><p>Display and headings.</p></div>
      <div class="specimen"><p class="eyebrow">Inter · 400</p><p>Static knowledge is readable without JavaScript. Interactive regions share state when the task calls for it.</p><p class="muted">Secondary text remains readable on every surface.</p></div>
      <div class="specimen"><p class="eyebrow">JetBrains Mono · 400</p><pre><code>npm ci
npm run dev</code></pre><p>Commands, code and filenames.</p></div>
    </div>
  </section>

  <section aria-labelledby="control-title">
    <h2 id="control-title">Controls and states</h2>
    <form class="specimen" action={`${base}workspace/`}>
      <div class="control-grid">
        <label>Workspace name<input name="name" value="Investigation" /></label>
        <label>View<select name="view"><option>Summary</option><option>Detailed</option></select></label>
        <label class="check-label"><input type="checkbox" name="updates" checked /> Receive updates</label>
      </div>
      <div class="actions"><button type="submit" class="primary">Open workspace</button><button type="reset">Reset fields</button></div>
      <p class="design-error"><strong>Error example:</strong> Choose a source before starting a request.</p>
      <p class="muted">Tab through the fields to inspect keyboard focus. Reset fields restores this form.</p>
    </form>
  </section>

  <section aria-labelledby="palette-title">
    <h2 id="palette-title">{theme === 'dark' ? 'Nuit' : 'Jour'} palette</h2>
    <ul class="swatches">
      {colors.map(token => <li><div class="swatch" style={{ background: token.value[theme] }} aria-hidden="true"></div><strong>{token.name}</strong><code>{token.value[theme]}</code></li>)}
    </ul>
    <p class="muted">Hairlines are decorative. Controls use their own border token; light raised controls use a tested contrast adjustment.</p>
  </section>

  <section aria-labelledby="logo-title">
    <h2 id="logo-title">The mark</h2>
    <div class="logo-grid">
      <figure class="logo-tile dark"><img src={darkLogo} alt="astrok color mark on a dark background" width="96" height="96" /><figcaption>Color · dark backgrounds</figcaption></figure>
      <figure class="logo-tile light"><img src={inkLogo} alt="astrok ink mark on a light background" width="96" height="96" /><figcaption>Ink · light backgrounds</figcaption></figure>
      <figure class="logo-tile dark"><img src={whiteLogo} alt="astrok white mark on a dark background" width="96" height="96" /><figcaption>White · dark backgrounds</figcaption></figure>
      <figure class="logo-tile"><img src={appIcon} alt="astrok application icon" width="96" height="96" /><figcaption>Application icon</figcaption></figure>
    </div>
  </section>
</Layout>
<style>
  .intro{max-width:48rem;margin-block:1rem 3rem}.eyebrow{font-size:.75rem;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-muted)}.lede{font-size:1.2rem}.theme-links{display:flex;flex-wrap:wrap;gap:1.5rem}.theme-links [aria-current]{text-decoration-thickness:3px;text-underline-offset:.4em}section{margin-block:3rem}.design-cover{position:relative;isolation:isolate;min-height:288px;overflow:hidden;border:1px solid var(--hairline);border-radius:var(--radius-lg);background:var(--ground);margin:0}.design-cover svg{position:absolute;right:0;top:0;height:100%;width:100%;z-index:-1}.design-cover figcaption{display:flex;flex-direction:column;gap:1rem;padding:3rem;max-width:52%}.design-cover strong{font-family:var(--font-display);font-weight:600;font-size:clamp(3.5rem,9vw,7rem);line-height:.92;letter-spacing:-.03em}.design-cover span{font-size:.875rem;color:var(--ink-muted)}.muted{color:var(--ink-muted)}.specimen-grid,.control-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.5rem}.specimen{min-width:0;background:var(--surface);padding:1.5rem;border:1px solid var(--hairline);border-radius:var(--radius-lg)}.specimen h3{font-size:1.5rem}.specimen pre{overflow:auto;max-width:100%;padding:1rem;background:var(--surface-raised);border-radius:var(--radius-md)}.actions{display:flex;flex-wrap:wrap;gap:.5rem;margin-block:1rem}.check-label{display:flex;align-items:center;gap:.5rem}.design-error{color:var(--danger)}.swatches{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:1rem;padding:0;list-style:none}.swatches li{display:flex;flex-direction:column;gap:.4rem;min-width:0}.swatch{height:5rem;border:1px solid var(--hairline);border-radius:var(--radius-md)}.swatches code{color:var(--ink-muted)}.logo-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem}.logo-tile{margin:0;padding:1.5rem;display:grid;justify-items:center;gap:1rem;border-radius:var(--radius-lg);background:var(--surface);border:1px solid var(--hairline);text-align:center;font-size:.875rem}.logo-tile.dark{background:#0E1020;color:#F4F4F0}.logo-tile.light{background:#F7F6F1;color:#0E1020}.logo-tile img{padding:12px;box-sizing:content-box}
  @media(max-width:760px){.specimen-grid,.control-grid{grid-template-columns:1fr}.logo-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.design-cover figcaption{padding:1.5rem;max-width:100%;padding-bottom:10rem}.design-cover svg{height:140px;top:auto;bottom:0;width:100%;opacity:.9}.design-cover{min-height:320px}.logo-tile{padding:.75rem}.logo-tile img{width:64px;height:64px}}
</style>
