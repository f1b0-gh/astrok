{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "types": [],
    "strict": true, "verbatimModuleSyntax": true, "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true, "skipLibCheck": true,
    "declaration": true, "rootDir": "src", "outDir": "dist"
  },
  "include": ["src/**/*.ts"]
}
