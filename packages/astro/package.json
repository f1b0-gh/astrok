{
  "name": "@astrok/astro",
  "version": "0.1.0",
  "type": "module",
  "description": "Configurable OKF publication for Astro with optional Starlight presentation",
  "files": [
    "dist",
    "README.md",
    "LICENSE*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./starlight": {
      "types": "./dist/starlight.d.ts",
      "import": "./dist/starlight.js"
    },
    "./solid": {
      "types": "./dist/solid.d.ts",
      "import": "./dist/solid.js"
    },
    "./solid/server": {
      "types": "./dist/solid-server.d.ts",
      "import": "./dist/solid-server.js"
    },
    "./solid/client": {
      "types": "./dist/solid-client.d.ts",
      "import": "./dist/solid-client.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@astrok/okf": "0.1.0",
    "magic-string": "1.4.5",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@astrojs/starlight": "0.43.1",
    "@solidjs/compiler": "^2.0.0",
    "@solidjs/vite-plugin": "^3.0.1",
    "@solidjs/web": "^2.0.0",
    "astro": "7.4.13",
    "solid-js": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@astrojs/starlight": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "@solidjs/web": {
      "optional": true
    },
    "@solidjs/compiler": {
      "optional": true
    },
    "@solidjs/vite-plugin": {
      "optional": true
    }
  },
  "license": "MIT OR Apache-2.0"
}
