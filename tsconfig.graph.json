{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "allowJs": true,
    "checkJs": false,
    "types": [
      "node"
    ],
    "skipLibCheck": true
  },
  "include": [
    "backend/**/*.ts",
    "scripts/graph.ts",
    "tests/graph*.ts"
  ]
}
